# -------------------------------------------------------------
# AWS-VERSE Environment Configuration
# -------------------------------------------------------------

# Priority 1: Google Apps Script Web App URL (Google Sheets integration)
# Set your deployed Google Apps Script URL here:
GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Priority 2: EmailJS Credentials (Spider-Verse Pass Email Dispatch)
EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id

EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional: Cloudflare D1 Database (for legacy /api/registration endpoint)
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=
